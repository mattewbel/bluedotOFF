<?xml version="1.0" encoding="utf-8"?>
<!-- 1.3.0 home-screen widget: one 4x1 bar with only what matters (owner 2026-10-29). Texts are set by StatusWidget in the
     app language; the picker preview shows the name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="4dp"
    android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_dot" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/widget_dot"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:text="@string/brand_name" android:textColor="@color/widget_text"
            android:textSize="16sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp"
            android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_muted" android:textSize="13sp" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp"
        android:src="@drawable/widget_refresh" android:visibility="gone" />
</LinearLayout>
